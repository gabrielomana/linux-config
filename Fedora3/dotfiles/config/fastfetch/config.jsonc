{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "  󰽢 OS       "
    },
    {
      "type": "kernel",
      "key": "  󰅚 Kernel   "
    },
    {
      "type": "shell",
      "key": "  󱆃 Shell    "
    },
    {
      "type": "terminal",
      "key": "  󰆍 Terminal "
    },
    {
      "type": "de",
      "key": "  󰖲 DE       "
    },
    {
      "type": "uptime",
      "key": "  󰅐 Uptime   "
    },
    {
      "type": "packages",
      "key": "  󰏖 Packages "
    },
    "break",
    "colors"
  ]
}
