################################################################################
# FEDORA3 AUTOMATION SUITE - GLOBAL CONFIGURATION
# Configuración centralizada para todos los scripts
# Author: Claude Code (Especialista Linux/Fedora/Bash)
# License: MIT
################################################################################

# ============================================================================
# SCRIPT DIRECTORY DETECTION
# ============================================================================
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# ============================================================================
# FEDORA VERSION DETECTION
# ============================================================================
FEDORA_VERSION=$(grep -oP '(?<=VERSION_ID=)\d+' /etc/os-release 2>/dev/null || echo "latest")

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_DIR="${HOME}/fedora_logs"
LOG_FILE="${LOG_DIR}/fedora_$(date +%Y%m%d_%H%M%S).log"
ERROR_LOG="${LOG_DIR}/fedora_errors.log"

# ============================================================================
# SSH CONFIGURATION
# ============================================================================
SSH_PORT="2222"
SSH_TIMEOUT="30"
SSH_MAXAUTH_TRIES="3"

# ============================================================================
# FIREWALL CONFIGURATION
# ============================================================================
FIREWALL_ZONE="FedoraWorkstation"

# ============================================================================
# FAIL2BAN CONFIGURATION
# ============================================================================
FAIL2BAN_MAXRETRY="5"
FAIL2BAN_FINDTIME="600"
FAIL2BAN_BANTIME="3600"

# ============================================================================
# DNS OVER TLS CONFIGURATION
# ============================================================================
DNS_PRIMARY="8.8.8.8"
DNS_SECONDARY="1.1.1.1"
DNS_FALLBACK1="8.8.4.4"
DNS_FALLBACK2="1.0.0.1"

# ============================================================================
# DNF CONFIGURATION
# ============================================================================
DNF_MAXPARALLEL="10"
DNF_FASTESTMIRROR="true"
DNF_KEEPCACHE="true"

# ============================================================================
# BTRFS CONFIGURATION
# ============================================================================
BTRFS_COMPRESSION="zstd:3"
BTRFS_MOUNT_OPTS="zstd:3,noatime,space_cache=v2,autodefrag"
BTRFS_SUBVOLS=("@" "@home" "@log" "@var_tmp" "@cache" "@snapshots")

# ============================================================================
# TIMESHIFT CONFIGURATION
# ============================================================================
TIMESHIFT_SCHEME="btrfs"
TIMESHIFT_SCHEDULE_HOURLY="false"
TIMESHIFT_SCHEDULE_DAILY="true"
TIMESHIFT_SCHEDULE_WEEKLY="true"
TIMESHIFT_SCHEDULE_MONTHLY="false"
TIMESHIFT_COUNT_HOURLY="6"
TIMESHIFT_COUNT_DAILY="7"
TIMESHIFT_COUNT_WEEKLY="4"
TIMESHIFT_COUNT_MONTHLY="0"

# ============================================================================
# KDE PLASMA CONFIGURATION
# ============================================================================
KDE_PLASMA_VERSION="6"
KONSOLE_THEME="FedoraDev"
SDDM_THEME="breeze"

# ============================================================================
# REPOSITORY URLS
# ============================================================================
FLATPAK_FLATHUB_URL="https://flathub.org/repo/flathub.flatpakrepo"
GRUB_BTRFS_REPO="https://github.com/Antynea/grub-btrfs.git"
MYSTARSHIP_THEMES_REPO="https://github.com/starship/starship/tree/master/docs/preset-configs"

# ============================================================================
# GITHUB REPOSITORIES
# ============================================================================
OH_MY_ZSH_REPO="https://github.com/ohmyzsh/ohmyzsh.git"
ZSH_AUTOSUGGESTIONS_REPO="https://github.com/zsh-users/zsh-autosuggestions.git"
ZSH_SYNTAX_HIGHLIGHTING_REPO="https://github.com/zsh-users/zsh-syntax-highlighting.git"
ZSH_HISTORY_SUBSTRING_REPO="https://github.com/zsh-users/zsh-history-substring-search.git"
FZF_ZSH_REPO="https://github.com/junegunn/fzf.git"

# ============================================================================
# APPLICATION DIRECTORIES
# ============================================================================
HOME_DIR="${HOME}"
CONFIG_DIR="${HOME}/.config"
LOCAL_DIR="${HOME}/.local"
ZSH_CUSTOM_DIR="${ZSH_CUSTOM:-${HOME}/.oh-my-zsh/custom}"
STARSHIP_CONFIG="${CONFIG_DIR}/starship.toml"

# ============================================================================
# GPU DETECTION
# ============================================================================
GPU_TYPE="$(
    if lspci 2>/dev/null | grep -qi "Intel"; then
        echo "intel"
    elif lspci 2>/dev/null | grep -qi "AMD"; then
        echo "amd"
    elif lspci 2>/dev/null | grep -qi "NVIDIA"; then
        echo "nvidia"
    else
        echo "unknown"
    fi
)"

# ============================================================================
# SYSTEM DETECTION
# ============================================================================
IS_VIRTUAL_MACHINE=$(systemd-detect-virt &>/dev/null && echo "true" || echo "false")
SYSTEM_CPUS=$(nproc 2>/dev/null || echo "1")
SYSTEM_RAM_MB=$(($(grep MemTotal /proc/meminfo | awk '{print $2}') / 1024))

# ============================================================================
# BOOLEAN CONFIGURATION
# ============================================================================
ENABLE_FAIL2BAN="true"
ENABLE_FIREWALL="true"
ENABLE_SELINUX="true"
ENABLE_AUTOMATIC_UPDATES="true"
ENABLE_MICROCODE="true"

# ============================================================================
# EXPORT ALL VARIABLES
# ============================================================================
export SCRIPT_DIR PROJECT_ROOT FEDORA_VERSION LOG_DIR LOG_FILE ERROR_LOG
export SSH_PORT SSH_TIMEOUT SSH_MAXAUTH_TRIES
export FIREWALL_ZONE
export FAIL2BAN_MAXRETRY FAIL2BAN_FINDTIME FAIL2BAN_BANTIME
export DNS_PRIMARY DNS_SECONDARY DNS_FALLBACK1 DNS_FALLBACK2
export DNF_MAXPARALLEL DNF_FASTESTMIRROR DNF_KEEPCACHE
export BTRFS_COMPRESSION BTRFS_MOUNT_OPTS BTRFS_SUBVOLS
export TIMESHIFT_SCHEME TIMESHIFT_SCHEDULE_DAILY TIMESHIFT_SCHEDULE_WEEKLY
export TIMESHIFT_COUNT_DAILY TIMESHIFT_COUNT_WEEKLY
export KDE_PLASMA_VERSION KONSOLE_THEME SDDM_THEME
export FLATPAK_FLATHUB_URL GRUB_BTRFS_REPO MYSTARSHIP_THEMES_REPO
export OH_MY_ZSH_REPO ZSH_AUTOSUGGESTIONS_REPO ZSH_SYNTAX_HIGHLIGHTING_REPO
export ZSH_HISTORY_SUBSTRING_REPO FZF_ZSH_REPO
export HOME_DIR CONFIG_DIR LOCAL_DIR ZSH_CUSTOM_DIR STARSHIP_CONFIG
export GPU_TYPE IS_VIRTUAL_MACHINE SYSTEM_CPUS SYSTEM_RAM_MB
export ENABLE_FAIL2BAN ENABLE_FIREWALL ENABLE_SELINUX ENABLE_AUTOMATIC_UPDATES
export ENABLE_MICROCODE

################################################################################
# END OF FILE
################################################################################
